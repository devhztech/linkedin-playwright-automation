# Execution mode: "demo" (safe local sandbox for testing/Loom) or "live" (real LinkedIn)
APP_MODE=demo

# Browser settings
HEADLESS=false
SLOW_MO_MS=40
USER_DATA_DIR=./browser_profile

# Rate limits (per 24h)
MAX_CONNECTIONS_PER_DAY=20
MAX_MESSAGES_PER_DAY=35
MAX_PROFILE_VIEWS_PER_DAY=80

# Human-like delay bounds (seconds)
MIN_ACTION_DELAY=2.5
MAX_ACTION_DELAY=6.0

# Search & outreach defaults
SEARCH_QUERY=SaaS Founder
MAX_LEADS_PER_RUN=5

